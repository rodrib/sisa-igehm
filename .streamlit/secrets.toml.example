# Copiar a .streamlit/secrets.toml y completar.
# .streamlit/secrets.toml tiene que estar en .gitignore

app_password = "una-contraseña-larga"

# --- Modo prototipo (CSV local) ---
# Por defecto lee data/pacientes.csv. Descomentá para usar otra ruta:
# csv_path = "data/pacientes.csv"

# --- Más adelante: Google Sheets ---
# Descomentar sheet_id y el bloque [gcp_service_account] para leer del Sheet.
# sheet_id = "ID_DEL_SHEET"
# worksheet = "Pacientes"
#
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "...@....iam.gserviceaccount.com"
# client_id = "..."
# auth_uri = "https://accounts.google.com/o/oauth2/auth"
# token_uri = "https://oauth2.googleapis.com/token"
